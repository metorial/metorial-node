{
  "name": "@metorial/util-resource-mapper",
  "version": "3.2.0",
  "author": "Metorial Inc.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/metorial/metorial-node"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./compact": {
      "types": "./dist/compact.d.ts",
      "import": "./dist/compact.js",
      "require": "./dist/compact.cjs",
      "default": "./dist/compact.js"
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "prettier src/**/*.ts --check",
    "build": "tsup"
  },
  "files": [
    "dist"
  ],
  "dependencies": {},
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.9.3",
    "vitest": "^0.34.6",
    "esbuild": "^0.25.12"
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "compact": [
        "dist/compact.d.ts"
      ]
    }
  }
}
